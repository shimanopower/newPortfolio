{
  "name": "newportfolio",
  "version": "1.0.0",
  "description": "A new work portfolio for my personal website",
  "main": "index.js",
  "scripts": {
    "build": "sass scss:dist/css --no-source-map",
    "watch:css": "sass --watch scss:dist/css --no-source-map",
    "preview": "python3 -m http.server 8000 --directory dist",
    "sass": "npm run watch:css",
    "prepare:dist": "cp CNAME dist/CNAME",
    "deploy": "npm run build && npm run prepare:dist && gh-pages -d dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shimanopower/newPortfolio.git"
  },
  "author": "Tristan Jackson",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/shimanopower/newPortfolio/issues"
  },
  "homepage": "https://audreysmonsters.com",
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "sass": "^1.98.0"
  }
}
